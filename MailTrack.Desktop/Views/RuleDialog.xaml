<Window x:Class="MailTrack.Desktop.Views.RuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add DLP Rule" Width="480" Height="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="New DLP Rule" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Rule Name" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtName" Padding="8,6" FontSize="13" Margin="0,0,0,12"/>

                <TextBlock Text="Description" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtDescription" Padding="8,6" FontSize="13" TextWrapping="Wrap"
                         AcceptsReturn="True" Height="60" Margin="0,0,0,12"/>

                <TextBlock Text="Rule Type" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbRuleType" SelectedIndex="0" Padding="8,6" FontSize="13" Margin="0,0,0,12">
                    <ComboBoxItem Content="Keyword" Tag="keyword"/>
                    <ComboBoxItem Content="Domain" Tag="domain"/>
                    <ComboBoxItem Content="Regex" Tag="regex"/>
                    <ComboBoxItem Content="Attachment Type" Tag="attachment_type"/>
                    <ComboBoxItem Content="Recipient Count" Tag="recipient_count"/>
                    <ComboBoxItem Content="PII Detection" Tag="pii"/>
                </ComboBox>

                <TextBlock Text="Pattern / Value" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtPattern" Padding="8,6" FontSize="13" Margin="0,0,0,12"/>

                <TextBlock Text="Direction" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbDirection" SelectedIndex="2" Padding="8,6" FontSize="13" Margin="0,0,0,12">
                    <ComboBoxItem Content="Incoming" Tag="incoming"/>
                    <ComboBoxItem Content="Outgoing" Tag="outgoing"/>
                    <ComboBoxItem Content="Both" Tag="both"/>
                </ComboBox>

                <TextBlock Text="Severity" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbSeverity" SelectedIndex="1" Padding="8,6" FontSize="13" Margin="0,0,0,12">
                    <ComboBoxItem Content="Low" Tag="low"/>
                    <ComboBoxItem Content="Medium" Tag="medium"/>
                    <ComboBoxItem Content="High" Tag="high"/>
                    <ComboBoxItem Content="Critical" Tag="critical"/>
                </ComboBox>

                <TextBlock Text="Action" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbAction" SelectedIndex="0" Padding="8,6" FontSize="13" Margin="0,0,0,12">
                    <ComboBoxItem Content="Alert" Tag="alert"/>
                    <ComboBoxItem Content="Flag" Tag="flag"/>
                    <ComboBoxItem Content="Log Only" Tag="log"/>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Padding="16,8" FontSize="13" Margin="0,0,8,0"
                    Background="#E0E0E0" Foreground="{StaticResource TextPrimaryBrush}"
                    BorderThickness="0" Click="Cancel_Click" Cursor="Hand"/>
            <Button Content="Save Rule" Style="{StaticResource FlatButton}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
