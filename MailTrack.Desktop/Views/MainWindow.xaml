<Window x:Class="MailTrack.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MailTrack.Desktop.ViewModels"
        Title="Mail Track - Email Monitoring" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Top Bar ═══ -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="&#x2709; Mail Track" FontSize="20" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>

                <!-- Search -->
                <Border Grid.Column="1" Background="#33FFFFFF" CornerRadius="4" Margin="24,0" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="White"
                                 FontSize="13" VerticalAlignment="Center" CaretBrush="White">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="Search" Style="{StaticResource FlatButton}"
                                Background="#22FFFFFF" Padding="12,4" Command="{Binding SearchCommand}"/>
                    </Grid>
                </Border>

                <!-- Monitor Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#x25B6; Start" Style="{StaticResource FlatButton}" Background="#4CAF50"
                            Padding="12,6" Margin="0,0,8,0" Command="{Binding StartMonitoringCommand}"
                            Visibility="{Binding IsMonitoring, Converter={StaticResource InvBoolToVis}}"/>
                    <Button Content="&#x25A0; Stop" Style="{StaticResource FlatButton}" Background="#F44336"
                            Padding="12,6" Command="{Binding StopMonitoringCommand}"
                            Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Main Content ═══ -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Margin="8"
                    BorderThickness="0" Background="Transparent">

            <!-- ── Emails Tab ── -->
            <TabItem Header="&#x2709; Emails">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Buttons -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,8">
                        <RadioButton Content="All" Style="{StaticResource NavButton}" GroupName="Filter"
                                     IsChecked="{Binding CurrentFilter, Converter={StaticResource FilterBool}, ConverterParameter=all}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="all"/>
                        <RadioButton Content="Incoming" Style="{StaticResource NavButton}" GroupName="Filter"
                                     IsChecked="{Binding CurrentFilter, Converter={StaticResource FilterBool}, ConverterParameter=incoming}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="incoming"/>
                        <RadioButton Content="Outgoing" Style="{StaticResource NavButton}" GroupName="Filter"
                                     IsChecked="{Binding CurrentFilter, Converter={StaticResource FilterBool}, ConverterParameter=outgoing}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="outgoing"/>
                        <RadioButton Content="Alerts" Style="{StaticResource NavButton}" GroupName="Filter"
                                     IsChecked="{Binding CurrentFilter, Converter={StaticResource FilterBool}, ConverterParameter=alerts}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="alerts"/>
                    </StackPanel>

                    <!-- Email List -->
                    <ListView Grid.Row="1" ItemsSource="{Binding Emails}" SelectedItem="{Binding SelectedEmail}"
                              BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="2,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Direction indicator bar -->
                                        <Border Grid.Column="0" CornerRadius="3" Width="4" Margin="0,0,8,0"
                                                Background="{Binding Direction, Converter={StaticResource DirectionColor}}"/>

                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Timestamp, Converter={StaticResource TimestampConv}}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Subject}" FontSize="13" Margin="0,2,0,0"
                                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding BodyPreview}" FontSize="12" Margin="0,2,0,0" MaxHeight="34"
                                                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border Background="#E0E0E0" CornerRadius="8" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding EmailClient}" FontSize="10" Foreground="#616161"/>
                                                </Border>
                                                <TextBlock Text="&#x1F4CE;" Visibility="{Binding HasAttachment, Converter={StaticResource BoolToVis}}"
                                                           FontSize="12" Margin="0,0,6,0"/>
                                                <TextBlock Text="&#x26A0;" Visibility="{Binding AlertTriggered, Converter={StaticResource BoolToVis}}"
                                                           FontSize="12" Foreground="Red"/>
                                                <TextBlock Text="&#x2691;" Visibility="{Binding Flagged, Converter={StaticResource BoolToVis}}"
                                                           FontSize="12" Foreground="Orange" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- ── Alerts Tab ── -->
            <TabItem Header="&#x26A0; Alerts">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,8">
                        <TextBlock Text="Pending Alerts" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Background="#F44336" CornerRadius="10" Padding="8,2" Margin="8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PendingAlertCount}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </Border>
                        <Button Content="Acknowledge All" Style="{StaticResource FlatButton}" Padding="12,4"
                                Command="{Binding AcknowledgeAllAlertsCommand}" Margin="8,0,0,0"/>
                    </StackPanel>

                    <ListView Grid.Row="1" ItemsSource="{Binding Alerts}" BorderThickness="0" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="2,3" BorderBrush="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                        BorderThickness="0,0,0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                                        CornerRadius="4" Padding="8,2">
                                                    <TextBlock Text="{Binding Severity}" Foreground="White" FontSize="10" FontWeight="Bold"
                                                               CharacterCasing="Upper"/>
                                                </Border>
                                                <TextBlock Text="{Binding Timestamp, Converter={StaticResource TimestampConv}}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="8,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding RuleName}" FontWeight="SemiBold" FontSize="14" Margin="0,6,0,0"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,2,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="&#x2713;" Style="{StaticResource FlatButton}"
                                                Background="#4CAF50" Padding="10,6" VerticalAlignment="Center"
                                                Command="{Binding DataContext.AcknowledgeAlertCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding Acknowledged, Converter={StaticResource InvBoolToVis}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- ── Rules Tab ── -->
            <TabItem Header="&#x2699; DLP Rules">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,8">
                        <TextBlock Text="DLP Policy Rules" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Content="+ Add Rule" Style="{StaticResource FlatButton}" Padding="12,4"
                                Margin="16,0,0,0" Click="AddRule_Click"/>
                    </StackPanel>

                    <ListView Grid.Row="1" ItemsSource="{Binding Rules}" BorderThickness="0" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="2,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,2,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Border Background="#E0E0E0" CornerRadius="8" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding RuleType}" FontSize="10"/>
                                                </Border>
                                                <Border Background="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                                        CornerRadius="8" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Severity}" FontSize="10" Foreground="White" CharacterCasing="Upper"/>
                                                </Border>
                                                <Border Background="#E0E0E0" CornerRadius="8" Padding="6,2">
                                                    <TextBlock Text="{Binding Direction}" FontSize="10"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                      Command="{Binding DataContext.ToggleRuleEnabledCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                            <Button Content="&#x2716;" Style="{StaticResource FlatButton}" Background="#F44336"
                                                    Padding="8,4"
                                                    Command="{Binding DataContext.DeleteRuleCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- ── Analytics Tab ── -->
            <TabItem Header="&#x1F4CA; Analytics">
                <ScrollViewer Margin="4" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Email Analytics" FontSize="20" FontWeight="Bold" Margin="4,8"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                        <!-- Stats Grid -->
                        <UniformGrid Columns="3" Margin="0,8">
                            <!-- Total -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding TotalCount}" FontSize="36" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Total Emails" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <!-- Incoming -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding IncomingCount}" FontSize="36" FontWeight="Bold"
                                               Foreground="#4CAF50" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Incoming" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <!-- Outgoing -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding OutgoingCount}" FontSize="36" FontWeight="Bold"
                                               Foreground="#2196F3" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Outgoing" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <!-- Alerts -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding AlertCount}" FontSize="36" FontWeight="Bold"
                                               Foreground="#F44336" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Emails with Alerts" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <!-- Active Rules -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveRuleCount}" FontSize="36" FontWeight="Bold"
                                               Foreground="#FF9800" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Active Rules" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <!-- Pending Alerts -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding PendingAlertCount}" FontSize="36" FontWeight="Bold"
                                               Foreground="#B71C1C" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Pending Alerts" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Accounts Tab ── -->
            <TabItem Header="&#x1F4E7; Accounts">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,8">
                        <TextBlock Text="Monitored Accounts" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Content="+ Add Account" Style="{StaticResource FlatButton}" Padding="12,4"
                                Margin="16,0,0,0" Click="AddAccount_Click"/>
                    </StackPanel>

                    <ListView Grid.Row="1" ItemsSource="{Binding Accounts}" BorderThickness="0" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="2,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                <Run Text="{Binding Email, Mode=OneWay}"/>
                                                <Run Text=" — "/>
                                                <Run Text="{Binding Host, Mode=OneWay}"/>
                                                <Run Text=":"/>
                                                <Run Text="{Binding Port, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Remove" Style="{StaticResource FlatButton}"
                                                Background="#F44336" Padding="10,4"
                                                Command="{Binding DataContext.RemoveAccountCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ═══ Status Bar ═══ -->
        <Border Grid.Row="2" Background="{StaticResource PrimaryDarkBrush}" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Foreground="#B0BEC5" FontSize="12"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Foreground="#B0BEC5" FontSize="12" Margin="0,0,16,0">
                        <Run Text="Emails: "/><Run Text="{Binding TotalCount, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Foreground="#B0BEC5" FontSize="12">
                        <Run Text="Alerts: "/><Run Text="{Binding PendingAlertCount, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
