<Window x:Class="MailTrack.Desktop.Views.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Email Account" Width="440" Height="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Add IMAP Account" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Account Name" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtName" Padding="8,6" FontSize="13" Margin="0,0,0,12"/>

                <TextBlock Text="Email Address" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtEmail" Padding="8,6" FontSize="13" Margin="0,0,0,12"/>

                <TextBlock Text="IMAP Server" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtHost" Padding="8,6" FontSize="13" Text="imap.gmail.com" Margin="0,0,0,12"/>

                <TextBlock Text="Port" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtPort" Padding="8,6" FontSize="13" Text="993" Margin="0,0,0,12"/>

                <TextBlock Text="Password / App Password" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="TxtPassword" Padding="8,6" FontSize="13" Margin="0,0,0,12"/>

                <CheckBox x:Name="ChkSsl" Content="Use SSL/TLS" IsChecked="True" FontSize="13"
                          Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                <TextBlock Text="Poll Interval (seconds)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtPollInterval" Padding="8,6" FontSize="13" Text="60" Margin="0,0,0,12"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Padding="16,8" FontSize="13" Margin="0,0,8,0"
                    Background="#E0E0E0" Foreground="{StaticResource TextPrimaryBrush}"
                    BorderThickness="0" Click="Cancel_Click" Cursor="Hand"/>
            <Button Content="Add Account" Style="{StaticResource FlatButton}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
